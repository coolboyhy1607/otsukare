{
  "manifest_version": 3,
  "name": "otsukare Autofill",
  "version": "0.4.0",
  "description": "同意した後にのみ、Slack / Notion のブラウザセッションから otsukare の日報用トークン（xoxc / xoxd / token_v2）を読み取り、otsukare に自動入力します。",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["cookies", "webRequest", "storage"],
  "host_permissions": ["*://*.slack.com/*", "*://*.notion.so/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "otsukare Autofill：同意の確認・取り消し",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_ui": { "page": "consent.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://otsukare-six.vercel.app/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
